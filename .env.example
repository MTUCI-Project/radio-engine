HTTP_ADDR=:8080
HTTP_BEARER_TOKEN=
INSTANCE_ID=radio-engine-1
MAX_STATIONS=20
SHUTDOWN_TIMEOUT_SECONDS=15

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

ICECAST_URL=http://icecast:8000
ICECAST_SOURCE_USER=source
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me
ICECAST_RELAY_PASSWORD=change-me
ICECAST_HOSTNAME=radio.example.com

STATION_DESCRIPTION=Radio Engine stream
STATION_GENRE=Various

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_REGION=
MINIO_TIMEOUT_SECONDS=15
MINIO_RETRIES=3

MEDIA_CACHE_DIR=/var/cache/radio-engine
MEDIA_CACHE_MAX_BYTES=5368709120

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM=radio.events
REDIS_TIMEOUT_SECONDS=3

DOMAIN=radio.example.com